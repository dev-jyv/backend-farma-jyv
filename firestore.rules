rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRoleSlug(slug) {
      return isAuthenticated() && request.auth.token.roleSlug == slug;
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.roleId != null ||
        request.auth.token.roleSlug != null ||
        request.auth.token.role in ['admin', 'inventory', 'cashier', 'manager', 'doctor']
      );
    }

    function canManageInventory() {
      return hasRoleSlug('admin') || hasRoleSlug('manager');
    }

    function canAccessSales() {
      return hasRoleSlug('admin') || hasRoleSlug('cashier') || hasRoleSlug('manager');
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    match /roles/{roleId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /suppliers/{supplierId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /batches/{batchId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /stockMovements/{movementId} {
      allow read: if canManageInventory();
      allow write: if false;
    }

    match /inventoryEntries/{entryId} {
      allow read: if canManageInventory();
      allow write: if false;
    }

    match /sales/{saleId} {
      allow read: if canAccessSales();
      allow write: if false;
    }
  }
}
