# Plantilla de variables de entorno. Copiar a `functions/.env` y rellenar.
# `functions/.env` está en `.gitignore` y NO debe versionarse: lleva secretos.

# --- Cloudflare R2: comprobantes de factura ---
# El accountId ES el subdominio del endpoint S3 de R2
# (https://<accountId>.r2.cloudflarestorage.com), así que el endpoint se deriva
# de aquí y no se configura aparte.
R2_ACCOUNT_ID=37e1c56124a03b79da9218615b20f8ff
R2_BUCKET=
# Token de API de R2 con permiso de lectura y escritura SOLO sobre ese bucket.
# El bucket debe quedar PRIVADO: las descargas van por URL firmada con
# caducidad. Si se expone por un dominio público, la firma sobra y cualquiera
# que adivine la ruta lee el comprobante.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Sin estas cuatro variables, los comprobantes siguen yendo a Firebase Storage:
# la factura se registra igual en vez de tumbar la caja porque falta un secreto.

# --- Los demás secretos que ya usa el backend (ver src/config/env.ts) ---
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_USER_ID=
# MERCADOPAGO_WEBHOOK_SECRET=
# RESEND_API_KEY=
# REPORTS_EMAIL_FROM=
# REPORTS_EMAIL_TO=
# MIGRATE_SECRET=
