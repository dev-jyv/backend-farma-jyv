# Valores de los secretos para el EMULADOR y `npm run dev` (SPEC 35). Copiar a
# `functions/.secret.local` (ignorado por git y por el deploy), o dejar que
# `npm run emulators` lo genere solo (scripts/ensure-secret-local.mjs).
#
# El emulador de Functions busca en Secret Manager todo secreto que este archivo
# no defina con un valor no vacío. `" "` (un blanco entre comillas) cuenta como
# valor para el emulador —no sale a buscarlo— y el backend lo trata como "no
# configurado": la ruta responde el mismo error controlado que sin la variable,
# y R2 sin llaves manda las facturas a `uploads/`.
#
# Nunca pongas aquí credenciales de producción. Para probar contra un servicio
# real, usa las de prueba (Mercado Pago TEST-..., bucket R2 aparte).

# Secreto de las rutas /v1/internal/* en local (valor de juguete).
MIGRATE_SECRET=local-dev-secret

MERCADOPAGO_ACCESS_TOKEN=" "
MERCADOPAGO_WEBHOOK_SECRET=" "
RESEND_API_KEY=" "
R2_ACCESS_KEY_ID=" "
R2_SECRET_ACCESS_KEY=" "
OPENROUTER_API_KEY=" "
