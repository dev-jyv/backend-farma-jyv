# Variables del proyecto en la nube `farma-jyv-dev`. Copiar a
# `functions/.env.farma-jyv-dev` y rellenar con credenciales de PRUEBA.
#
# `firebase deploy --project dev` carga `.env` y después este archivo. Por eso
# `functions/.env` solo debe tener valores comunes sin secretos: los secretos de
# producción van en `functions/.env.farma-jyv` (ver `.env.example`), o se
# desplegarían también a dev.

CORS_ORIGINS=https://farma-jyv-dev.web.app,https://farma-jyv-dev-clinic.web.app,http://localhost:4200,http://localhost:4300,http://localhost:4400
MIGRATE_SECRET=

# Mercado Pago: credenciales de la cuenta de PRUEBA (TEST-...), nunca las de producción.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_USER_ID=
MERCADOPAGO_WEBHOOK_SECRET=

# Resend: dominio o destinatario de pruebas.
RESEND_API_KEY=
REPORTS_EMAIL_FROM=
REPORTS_EMAIL_TO=

# R2: bucket PRIVADO distinto al de producción. Sin estas 4, va a Firebase Storage de dev.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

FIRESTORE_BACKUP_BUCKET=
RECEIPT_STORE_NAME=Farmacia JyV (DEV)
