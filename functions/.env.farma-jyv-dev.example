# Configuración NO secreta del proyecto en la nube `farma-jyv-dev`. Copiar a
# `functions/.env.farma-jyv-dev` y rellenar.
#
# `firebase deploy --project dev` carga `.env` y después este archivo. Por eso
# `functions/.env` solo debe tener valores comunes, y este archivo tampoco lleva
# secretos: los siete (MERCADOPAGO_ACCESS_TOKEN, MERCADOPAGO_WEBHOOK_SECRET,
# RESEND_API_KEY, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, MIGRATE_SECRET,
# OPENROUTER_API_KEY) se crean en Secret Manager de `farma-jyv-dev` con
# credenciales de PRUEBA (RUNBOOK «Secretos»). check-env-split.mjs rechaza el
# deploy si alguno aparece aquí, aunque sea vacío.

CORS_ORIGINS=https://farma-jyv-dev.web.app,https://farma-jyv-dev-clinic.web.app,http://localhost:4200,http://localhost:4300,http://localhost:4400

# Mercado Pago: cuenta de PRUEBA (TEST-...), nunca la de producción.
MERCADOPAGO_USER_ID=

# Resend: dominio o destinatario de pruebas.
REPORTS_EMAIL_FROM=
REPORTS_EMAIL_TO=

# R2: bucket PRIVADO distinto al de producción. Sin cuenta, bucket o alguna de las
# dos llaves de Secret Manager, va a Firebase Storage de dev.
R2_ACCOUNT_ID=
R2_BUCKET=

FIRESTORE_BACKUP_BUCKET=
RECEIPT_STORE_NAME=Farmacia JyV (DEV)
