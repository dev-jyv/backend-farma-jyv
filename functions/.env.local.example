# Variables para los EMULADORES locales y `npm run dev`. Copiar a `functions/.env.local`.
#
# El emulador de Functions carga `.env` y después `.env.local`, que gana. Aquí no
# va ningún secreto real: el proyecto del emulador es `demo-farmajyv` y nada debe
# salir a Mercado Pago, Resend, R2 ni OpenRouter reales.
# `npm run emulators` se niega a arrancar si un `.env` desplegable todavía trae
# secretos (ver scripts/check-env-split.mjs).
#
# Los valores de los secretos (MIGRATE_SECRET y compañía) van en
# `functions/.secret.local` (ver .secret.local.example), que `npm run emulators`
# completa solo. Si ya tenías alguno aquí, se copia allá la primera vez.

CORS_ORIGINS=http://localhost:4200,http://localhost:4300,http://localhost:4400,http://127.0.0.1:4200,http://127.0.0.1:4300,http://127.0.0.1:4400

# Sin R2_ACCOUNT_ID/R2_BUCKET ni llaves: los comprobantes van al emulador de Storage.
# Sin valores de MERCADOPAGO_* / RESEND_* / OPENROUTER_* en .secret.local: esas
# rutas responden error controlado en vez de llamar a servicios reales.

RECEIPT_STORE_NAME=Farmacia JyV (LOCAL)
