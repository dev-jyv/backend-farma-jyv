{
  "name": "functions",
  "scripts": {
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .js,.ts,.tsx .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "npm run build && node --env-file=.env --env-file-if-exists=.env.local --env-file-if-exists=.secret.local lib/dev-server.js",
    "serve": "npm run emulators",
    "emulators": "node scripts/check-env-split.mjs && npm run build && node scripts/emulators.mjs",
    "seed:emulator": "npm run build && FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 GCLOUD_PROJECT=demo-farmajyv node lib/scripts/seed-emulator.js",
    "deploy": "npm run deploy:prod",
    "deploy:prod": "node scripts/check-env-split.mjs && npm run build && node scripts/check-secrets.mjs prod && firebase deploy --project prod --only functions,firestore:rules,firestore:indexes,storage",
    "migrate:roles": "npm run build && node lib/scripts/migrate-roles.js",
    "backfill:denormalized": "npm run build && node lib/scripts/backfill-denormalized.js",
    "backfill:search-name": "npm run build && node lib/scripts/backfill-search-name.js",
    "backfill:outstanding": "npm run build && node lib/scripts/backfill-outstanding.js",
    "backfill:calendar-dates": "npm run build && node lib/scripts/backfill-calendar-dates.js",
    "backfill:daily-stats": "npm run build && node lib/scripts/backfill-daily-stats.js",
    "pitr:restore": "npm run build && node lib/scripts/pitr-restore.js",
    "register:unreconciled": "npm run build && node lib/scripts/register-unreconciled.js",
    "logs": "firebase functions:log",
    "test": "firebase emulators:exec --only firestore \"jest\"",
    "test:rules": "jest --config jest.rules.config.js",
    "test:coverage": "firebase emulators:exec --only firestore \"jest --coverage\"",
    "check:promo-engine": "node scripts/check-promotions-engine.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@google-cloud/firestore": "^7.11.6",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "@sparticuz/chromium": "^153.0.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "puppeteer-core": "~25.11.0",
    "react": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.39.0",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^9.39.5",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.5.2",
    "puppeteer": "~25.11.0",
    "react-dom": "^19.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "allowScripts": {
    "puppeteer@25.4.0": true
  }
}
