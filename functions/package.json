{
  "name": "functions",
  "scripts": {
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .js,.ts,.tsx .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "npm run build && node --env-file=.env lib/dev-server.js",
    "serve": "npm run build && firebase emulators:start",
    "deploy": "npm run build && firebase deploy --only functions,firestore:rules,firestore:indexes,storage",
    "migrate:roles": "npm run build && node lib/scripts/migrate-roles.js",
    "backfill:denormalized": "npm run build && node lib/scripts/backfill-denormalized.js",
    "logs": "firebase functions:log",
    "test": "firebase emulators:exec --only firestore \"jest\"",
    "test:rules": "jest --config jest.rules.config.js",
    "test:coverage": "firebase emulators:exec --only firestore \"jest --coverage\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sparticuz/chromium": "^149.0.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.2.5",
    "puppeteer-core": "^25.4.0",
    "react": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.1",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "eslint": "^9.0.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.31.0",
    "firebase-functions-test": "^3.4.0",
    "jest": "^30.4.2",
    "puppeteer": "^25.4.0",
    "react-dom": "^19.2.8",
    "ts-jest": "^29.4.12",
    "typescript": "^5.7.3"
  },
  "private": true,
  "allowScripts": {
    "puppeteer@25.4.0": true
  }
}
