{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["npm --prefix functions run build"],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "firestore-debug.log",
        "*.local",
        "service-account.json",
        "**/service-account.json",
        "src",
        "test",
        "test-rules",
        "jest.rules.config.js",
        "graphify-out",
        "coverage",
        ".eslintrc.js",
        ".eslintignore",
        "tsconfig.json",
        "tsconfig.eslint.json",
        "jest.config.js"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": true
    }
  }
}
